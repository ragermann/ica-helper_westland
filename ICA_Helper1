function sampev.onPlayerStreamIn(playerid)
    if not mainIni.config.cstream_chat then return end
    local price = c_ids[playerid]
    local suppressUntil = cstream_completed_suppress[playerid]
    if suppressUntil and suppressUntil > os.clock() then return end
    if suppressUntil then cstream_completed_suppress[playerid] = nil end
    -- Не дублируем уведомление, если опрос списка уже сообщил об этом игроке.
    if price and not cstream_chat_seen[playerid] then
        lastct_instream = playerid
        cstream_chat_seen[playerid] = price
        local nickname = sampGetPlayerNickname(playerid) or ('ID '..playerid)
        sampAddChatMessage('{FFFBFB}[ {800000}ICA {FFFBFB}]: Контракт {800000}'..nickname:gsub('_', ' ')..' {FFFBFB}[ {800000}'..playerid..'{FFFBFB} ] в зоне стрима. Стоимость - {800000}'..price..'$.', -1)
    end
end

function sampev.onPlayerStreamOut(playerid)
    if not mainIni.config.cstream_chat then return end
    local suppressUntil = cstream_completed_suppress[playerid]
    if suppressUntil and suppressUntil > os.clock() then
        cstream_chat_seen[playerid] = nil
        return
    end
    if suppressUntil then cstream_completed_suppress[playerid] = nil end
    if cstream_chat_seen[playerid] then
        local nickname = sampGetPlayerNickname(playerid) or ('ID '..playerid)
        sampAddChatMessage('{FFFBFB}[ {800000}ICA {FFFBFB}]: Контракт {800000}'..nickname:gsub('_', ' ')..' {FFFBFB}[ {800000}'..playerid..'{FFFBFB} ] покинул зону стрима.', -1)
    end
    cstream_chat_seen[playerid] = nil
end

