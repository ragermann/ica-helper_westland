    local size = tonumber(arg)
    if not size or size < 50 or size > 200 or size ~= math.floor(size) then
        scriptMessage('Использовать: /hudfomo [50-200]')
        return
    end
    mainIni.config.hud_fomo = size
    hud_font_size = math.max(8, math.min(25, math.floor((tonumber(mainIni.config.font_size) or 12) * size / 100 + 0.5)))
