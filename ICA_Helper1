                renderFontDrawText(font_hud, "\x97", mainIni.hud.xpos + 281, mainIni.hud.ypos + 2, 2868903935.0)
                renderFontDrawText(font_hud, "\x97", mainIni.hud.xpos + 14, mainIni.hud.ypos + 2, 2868903935.0)
                local vehid = storeCarCharIsInNoSave(PLAYER_PED)
