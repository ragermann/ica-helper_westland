            if carmenu_count == 1 then
                sampSendDialogResponse(dialogid, 1, 0, -1)
            else
                carmenu_count = 0
                openCarDoors = false
            end
            return false
        end
    end

    if mainIni.config.autosum then
        if dialogid == 1036 then -- диалог решения примеров при взломе БД SWAT
            if text:find('{cccccc}Решите примеры, чтобы взломать базу данных {ffffff}') then
                local sum = text:match('{ff9000}(.+) =')
                if sum:find(' ') then sum = sum:gsub(' ', '') end
                if sum:find('x') then sum = sum:gsub('x', '*') end
                if sum:find(':') then sum = sum:gsub(':', '/') end
                local result, error = parseExpression(sum)
                if result then sampSendDialogResponse(dialogid, 1, -1, result) else print(error) end
                return false
            end
        end

        if dialogid == 1037 then -- юзлесс диалог
            if text:find('{99ff66}Ответ верный!') then
                sampSendDialogResponse(dialogid, 1, -1, -1)
                return false
            end
        end
    end

    if dialogid == 318 then
        if incInvis then
            sampSendDialogResponse(dialogid, 1, 2, -1)
            incInvis = false
            return false
        end
        if incSendAd then
            sampSendDialogResponse(dialogid, 1, 5, -1)
            incSendAd = false
            return false
        end
    end

    if dialogid == 586 then -- диалог менюшки агентства
        if incInvis then
            sampSendDialogResponse(dialogid, 1, 0, -1)
            incInvis = false
            return false
        end
        if incSendAd then
            sampSendDialogResponse(dialogid, 1, 2, -1)
            incSendAd = false
            return false
        end
        text = text:gsub('Отключить Цвет', 'Отключить цвет') text = text:gsub('Список Заказов', 'Список заказов') text = text:gsub('Реклама Агенства', 'Реклама агентства')
        return {dialogid, style, title, b1, b2, text}
    end

    if dialogid == 706 then
        if text:find('%w+_%w+%[%d+%]') then
            local signs = {}
            for member in text:gmatch('%w+_%w+%[%d+%]') do
                if member:match('(.+)%[') ~= sampGetPlayerNickname(member:match('%[(%d+)%]')) then
                    table.insert(signs, {name = member, sign = sampGetPlayerNickname(member:match('%[(%d+)%]'))})
                end
            end
            if #signs > 0 then 
                text = text..'\n \n{cccccc}Временные никнеймы:\n'
                for _, value in pairs(signs) do
                    text = string.format("%s%s = %s\n", text, value.name, value.sign)
                end
                return {dialogid, style, title, b1, b2, text}
            end
        end
    end

    -- Перехватываем /stats до отображения диалога: ищем именно строку
    -- «Аккаунт № ...», извлекаем число и сразу скрываем окно.
    do
        local rawStatsText = tostring(text or '')
        local plainStatsText = rawStatsText:gsub('{%x%x%x%x%x%x}', '')
        local accountLine = plainStatsText:match('[^\\r\\n]*Аккаунт%s*№[^\\r\\n]*')
        local parsedAccId

        if accountLine then
            -- Сначала ищем число после знака № в очищенной строке.
            parsedAccId = accountLine:match('Аккаунт%s*№%s*(%d+)')
            -- Запасной вариант для цветового кода/разметки между меткой и числом.
            if not parsedAccId then
                parsedAccId = accountLine:match('Аккаунт%s*№.-(%d+)')
            end
        end

        if parsedAccId then
            acc_id = tonumber(parsedAccId)
            openStats = false
            -- Скрываем статистику только если она была открыта самой командой /zask.
            -- При обычном ручном /stats обновляем acc_id, но оставляем окно видимым.
            if zaskSilentStats then
                zaskSilentStats = false
                return false
            end
        elseif dialogid == 1500 and openStats then
            openStats = false
            if zaskSilentStats then zaskSilentStats = false end
        end
    end
    if dialogid == 1700 then -- диалог ошибки (у вашего персонажа заняты руки и т.п.)
		if text:find('{FF6347}Вы не за рулём транспортного средства %[ Управление транспортом ALT %]') then
			goKeyPressed(0x12)
			openCarDoors = true
			return false
		end
    end
    if openCar then
        if dialogid == 653 then -- диалог выбора транспорта в [/car]
            if openCar[1] ~= 3 then
                sampSendDialogResponse(dialogid, 1, openCar[2] - 1, -1)
                return false
            else
                openCar = false
            end
        elseif dialogid == 298 then -- меню взаимодействия с транспортом, после того как он был выбран
            if openCar[1] == 1 then
                sampSendDialogResponse(dialogid, 1, 0, -1)
            elseif openCar[1] == 2 then
                sampSendDialogResponse(dialogid, 1, 6, -1)
            elseif openCar[1] == 3 then
                return false
            end
            openCar = {3}
            return false
        end
    end
    if dialogid == 1700 then -- диалог списка заказов
        if openContractas then
            for line in text:gmatch("[^\r\n]+") do
                local id, sum = line:match('%[(%d+)%].-(%d+)%$')
                if id and sum then
                    c_ids[tonumber(id)] = sum
                end
            end
            openContractas = false
            sampSendDialogResponse(dialogid, 0, 0, 0)
            return false
        end

        local result = ""
        for line in text:gmatch('[^\r\n]+') do
            local id = line:match('%[(%d+)%]')
            line = line:gsub('ff9000', string.format('%06X', bit.band(sampGetPlayerColor(id),  0xFFFFFF)))
            result = result..line..'\n'
        end
        if not result then return scriptMessage('Список контрактов пуст') end
        return {dialogid, style, title, b1, b2, result}
    end
    if mainIni.config.automobile then
        if dialogid == 1178 then -- диалог при оплате счета мобильного телефона
            for line in text:gmatch('[^\r\n]+') do
                if line:find('%$') then
                    local pay = 5000 - line:match('(%d+)%$')
                    sampSendDialogResponse(dialogid, 1, nil, pay)
                    break
                end
            end
            return false
        end
    end
    if mainIni.config.autoburger then
        if dialogid == 392 then -- диалог при нажатии "H" в закусочной
            if not eat_state then
                checkPotreb = true
                sampSendChat('/potreb')
                return false
            end
        end
        if checkPotreb and dialogid == 1982 then -- диалог при вводе /potreb
            hungry = text:match("{0088ff}Голод {66ff99}(%d+)")
            return false
        end
    end
    if mainIni.config.autofill then
        if dialogid == 484 then -- диалог при заправке наземного транспорта
            for line in text:gmatch('[^\r\n]+') do
                if line:find('{99ff66}') then
                    local fill = line:match('Для полного бака вам требуется: (%d-) литров')
                    sampSendDialogResponse(dialogid, 1, -1, fill)
                end
            end
            return false
        end
        if dialogid == 764 then -- диалог при заправке воздушного транспорта
            if car.fuel ~= nil then
                sampSendDialogResponse(dialogid, 1, nil, 100 - car.fuel)
                return false
            end
        end
        if dialogid == 1990 then return false end -- юзлесс диалог :)
    end
    if mainIni.config.anonymizer then
        local result = text
        for k, v in pairs(anonymizer_names) do
            local name, mask = v:match('(.+) = (.+)')
            if result:find(name) then
                result = result:gsub(name, mask)
            end
        end
        return {dialogid, style, title, b1, b2, result}
    end
end

function sampev.onSendDialogResponse(dialogid, button, listitem, input)
    -- костыльное решение для фикса хуйни с некликабельными диалогами)
    dialog_cooldown = 2
    lua_thread.create(function()
        while dialog_cooldown > 0 do
            wait(1000)
            dialog_cooldown = dialog_cooldown - 1
        end
    end)
end

function sampev.onServerMessage(color, text)
    -- Запоминаем состояние никнейма по системным сообщениям сервера.
    if text:find('Я закрыл своё лицо', 1, true)
        or text:find('Я закрыл свое лицо', 1, true)
        or text:find('Никнейм отключён', 1, true)
        or text:find('Никнейм отключен', 1, true) then
        nametagEnabled = false
    elseif text:find('Я открыл своё лицо', 1, true)
        or text:find('Я открыл свое лицо', 1, true)
        or text:find('Никнейм включён', 1, true)
        or text:find('Никнейм включен', 1, true)
        or text:find('снова отображаюсь на карте', 1, true) then
        nametagEnabled = true
    end

    -- Обрабатываем именно итоговую строку сервера: «<< Агент № 292 выполнил контракт
    -- на Nick_Name [ID], и получил 5000$ >>». Цветовые коды могут меняться.
    local cleanContractText = tostring(text):gsub('{%x%x%x%x%x%x}', '')
    local contractAgent, ct_name, target_id, reward = cleanContractText:match(
        'Агент%s*№%s*(%d+)%s+выполнил контракт на%s+([^,]-)%s*%[(%d+)%]%s*,%s*и получил%s*(%d+)%$'
    )
    if not contractAgent then
        contractAgent, ct_name, reward = cleanContractText:match(
            'Агент%s*№%s*(%d+)%s+выполнил контракт на%s+([^,]-),%s*и получил%s*(%d+)%$'
        )
    end
    if contractAgent then
        ct_name = (ct_name or 'Неизвестно'):gsub('%s+$', '')
        -- После успешного выполнения цель не должна считаться «покинувшей стрим».
        -- Серверный итог содержит ID цели; подавляем повторные уведомления на короткое время,
        -- пока список /contractas обновится.
        if target_id then
            local completedId = tonumber(target_id)
            if completedId then
                cstream_completed_suppress[completedId] = os.clock() + 30
                cstream_chat_seen[completedId] = nil
            end
        end
        local diag = io.open(script_directory..'/workability_debug.txt', 'a')
        if diag then diag:write(os.date('%Y-%m-%d %H:%M:%S')..' CONTRACT: '..cleanContractText..'\n'); diag:close() end
        lua_thread.create(function () wait(1000) mainIni.temp.accept_ct = nil end)
        if cfd and ct_name and cfd == sampGetPlayerIdByNickname(ct_name) then cfd = nil end
        local damage = (lastdamage and tonumber(lastdamage.damage)) or 0
        local weapon = (lastdamage and lastdamage.weapon and lastdamage.weapon.name) or 'Неизвестно'
        mainIni.stats = type(mainIni.stats) == 'table' and mainIni.stats or {}
        local stamp = os.time()
        -- Тип 1 — выполненный контракт; тип 2 — убийство по контракту.
        table.insert(mainIni.stats, '1,0,'..stamp..','..tostring(ct_name)..','..math.floor(damage)..','..weapon..','..tostring(reward)..'$')
        table.insert(mainIni.stats, '2,0,'..stamp..','..tostring(ct_name)..','..tostring(reward)..'$')
        saveWorkabilityStats()
    end

    if acc_id ~= nil then
        if text:find('{8B8B8B}Агент №'..acc_id..' {FF0000}принял контракт на: {8B8B8B}.-%[%d-%] {00AC31}Цена: %d-$ {cccccc}') then
            mainIni.temp.accept_ct = text:match('на: {8B8B8B}(.-)%[%d-%]')
        end
        if text:find('{FF0000}%*%* {8B8B8B}.- поручил {FF0000}Агенту №{8B8B8B}'..acc_id..' {FF0000}выполнить контракт на: {8B8B8B}.- %*%*') then
            mainIni.temp.accept_ct = text:match('на: {8B8B8B}(.-) %*%*')
        end
        if text:find('{FF0000}%*%* {8B8B8B}Агент №'..acc_id..' {FF0000}отказывается выполнять контракт на: {8B8B8B}.+%[%d+%] {FF0000}%*%*') then
            mainIni.temp.accept_ct = nil
        end
    end
    if mainIni.config.customctstr then
        -- Парсим обычный текст без цветовых кодов: формат цветов и звёздочек
        -- у сервера может отличаться между версиями.
        local contractPlain = tostring(text):gsub('{%x%x%x%x%x%x}', '')
        local number, nick, id, price

        -- Принятие контракта: «Агент № 292 принял контракт на: Nick[8]. Цена: 5000$».
        number, nick, id, price = contractPlain:match(
            'Агент%s*№%s*(%d+)%s+принял контракт на:%s*(.-)%s*%[(%d+)%]%s*%.?%s*Цена:%s*(%d+)%$'
        )
        if number and id and price then
            local playerId = tonumber(id)
            local playerName = sampIsPlayerConnected(playerId) and sampGetPlayerNickname(playerId) or nick
            local playerColor = sampIsPlayerConnected(playerId) and sampGetPlayerColor(playerId) or 0xFFFFFFFF
            local colour = string.format('%06X', bit.band(playerColor, 0xFFFFFF))
            return {color, '{828282}Агент №'..number..' принял контракт на: {'..colour..'}'..playerName..'{828282} ['..id..'] | Цена: {00BC12}'..price..'$'}
        end

        -- Отказ от контракта.
        number, nick, id = contractPlain:match(
            'Агент%s*№%s*(%d+)%s+отказывается выполнять контракт на:%s*(.-)%s*%[(%d+)%]%s*%.?'
        )
        if number and id then
            local playerId = tonumber(id)
            local playerName = sampIsPlayerConnected(playerId) and sampGetPlayerNickname(playerId) or nick
            local playerColor = sampIsPlayerConnected(playerId) and sampGetPlayerColor(playerId) or 0xFFFFFFFF
            local colour = string.format('%06X', bit.band(playerColor, 0xFFFFFF))
            return {color, '{828282}Агент №'..number..' отказывается выполнять контракт на: {'..colour..'}'..playerName..'{828282} ['..id..']'}
        end

        -- Выполнение контракта; поддерживаем «и получил» и «получив».
        number, nick, id, price = contractPlain:match(
            'Агент%s*№%s*(%d+)%s+выполнил контракт на%s+([^,%[]-)%s*%[(%d+)%]%s*,?%s*[и]?%s*получ[и]?л%s*(%d+)%$'
        )
        if not number then
            number, nick, price = contractPlain:match(
                'Агент%s*№%s*(%d+)%s+выполнил контракт на%s+([^,]-),%s*получив%s*(%d+)%$'
            )
        end
        if number then
            return {color, '{CCCCCC}[ Мысли ]: Я выполняю свою работу.'}
        end
    end

    -- Автоскриншот после сообщения о переводе денег за контракт.
    -- Оставляем оригинальное сообщение сервера видимым.
    local plainText = tostring(text):gsub('{%x%x%x%x%x%x}', ''):gsub('ё', 'е'):gsub('Ё', 'Е')
    if plainText:find('Деньги перечислены на ваш банковский счет', 1, true)
        or plainText:find('деньги перечислены на ваш банковский счет', 1, true) then
        if mainIni.config.autoscreen then
            goKeyPressed(0x77) -- F8
        end
    end
    -- Сдача ящиков: учитываем порядок слов из реального чата сервера:
    -- «Я положила на склад Ящик (Винтовка) 8» и «Я положила на склад Ящик [Ammo 6.45mm | 86]».
    -- В Lua string.lower() может не переводить кириллицу в нижний регистр.
    -- Поэтому ищем фразу в исходном тексте, без зависимости от регистра в начале сообщения.
    if plainText:find('на склад Ящик', 1, true) or plainText:find('на склад ящик', 1, true) then
        local diag = io.open(script_directory..'/workability_debug.txt', 'a')
        if diag then diag:write(os.date('%Y-%m-%d %H:%M:%S')..' MATCH: '..plainText..'\n'); diag:close() end
        local payload = plainText:match('Ящик%s*%[%s*(.-)%s*%]')
        local ammo, n
        if payload then
            ammo, n = payload:match('^(.-)%s*|%s*(%d+)%s*$')
        end
        if not ammo then
            payload = plainText:match('Ящик%s*%((.-)%)%s*(%d+)')
            if payload then
                ammo, n = payload, plainText:match('Ящик%s*%([^)]*%)%s*(%d+)')
            end
        end
        if not ammo then
            payload, n = plainText:match('Ящик%s+(.+)%s+(%d+)%s*$')
            if payload then ammo = payload end
        end
        if ammo and n then
            local diag = io.open(script_directory..'/workability_debug.txt', 'a')
            if diag then diag:write('PARSED: ammo='..tostring(ammo)..' count='..tostring(n)..'\n'); diag:close() end
            ammo = ammo:gsub('^%s+', ''):gsub('%s+$', '')
            ammo = ammo:find(',', 1, true) and ammo:gsub(',', '.') or ammo
            mainIni.stats = type(mainIni.stats) == 'table' and mainIni.stats or {}
            table.insert(mainIni.stats, '3,'..ammo..','..os.time()..','..n)
            saveWorkabilityStats()
        end
        if mainIni.config.autoscreen then makeScreen('[БЯ]') end
    end
    -- Автоматическое принятие нового контракта (/autogoc).
    -- Не привязываемся к конкретным цветовым кодам в сообщении сервера.
    local agencyPlain = tostring(text):gsub('{%x%x%x%x%x%x}', '')
    -- Match the server contract format; title may be uppercase.
    local agencyName, agencyPrice = agencyPlain:match(
        '\xc0\xe3\xe5\xed\xf2\xf1\xf2\xe2\xee:%s*.-%s+\xed\xe0:%s*(.-),%s*\xf1\xf3\xec\xec\xe0:%s*(%d+)%$'
    )
    if agencyName and agencyPrice then
        agencyName = agencyName:gsub('%s*%[%s*/goc%s*%].*$', '')
        agencyName = agencyName:gsub('%s*%[%s*/givec%s*%].*$', '')
        agencyName = agencyName:gsub('%s*%[%d+%]%s*$', '')
        agencyName = agencyName:gsub('%s+$', '')
        mainIni.temp.last_ct = agencyName
        local priceValue = tonumber(agencyPrice)
        if autogoc_price ~= 0 and priceValue and priceValue >= autogoc_price then
            -- Do not yield inside sampev.onServerMessage.
            lua_thread.create(function()
                -- Delay automatic contract acceptance by 3 seconds.
                wait(3000)
                -- Re-check the configured threshold after the delay.
                if autogoc_price == 0 or priceValue < autogoc_price then return end
                local targetId = sampGetPlayerIdByNickname(agencyName)
                if not targetId or targetId < 0 then
                    for attempt = 1, 10 do
                        wait(100)
                        targetId = sampGetPlayerIdByNickname(agencyName)
                        if targetId and targetId >= 0 then break end
                    end
                end
                if targetId and targetId >= 0 and autogoc_price ~= 0 and priceValue >= autogoc_price then
                    sampSendChat('/goc '..targetId)
                    scriptMessage('\xc2\xfb \xe0\xe2\xf2\xee\xec\xe0\xf2\xe8\xf7\xe5\xf1\xea\xe8 \xe2\xe7\xff\xeb\xe8 \xea\xee\xed\xf2\xf0\xe0\xea\xf2 \xed\xe0 '..agencyName..' [ /autogoc 0 ]')
                end
            end)
        end
        -- Keep the original server message visible in chat (including its formatting
        -- and the 'new contract' text). Do not replace it with a modified plain-text line.
        return {color, text}
    end
    if text == '[ Мысли ]: Я не могу видеть список потенциальных жертв' then return false end
    if text == '[ Мысли ]: Я не могу искать человека' then return false end
    if text == '[ Мысли ]: На его нет контракта' then 
        local result = text:gsub('его', 'него') 
        return {color, result} 
    end
    if text == "[ Мысли ]: Я уже выполняю контракт [ /myc ]" then
        if acc_rank then
            if acc_rank > 1 then
                sampSendChat('/cancel')
                sampSendChat('/goc '..lastgocid)
                return false
            end
        end
    end

    if mainIni.config.anonymizer then
        for k, v in pairs(anonymizer_names) do
            local name, mask = v:match('(.+) = (.+)')
            if text:find(name) then
                text = text:gsub(name, mask)
                return {color, text}
            end
        end
    end

    if text:find('сбил.+с ног .+, ударом по голове') then lastknocked = sampGetPlayerIdByNickname(text:match('с ног (.+), ударом')) end

    local chat_filter = {
        ['misli'] = text:find('^%[ Мысли %]: '), -- Мысли
        ['p_adm'] = text:find('^%[RP%]'), -- Наказания от администрации
        ['frac'] = (text:find('{333333}%* .+%[%d+%]: {850000}Братья и сёстры, я объявляю общее собрание!') or text:find('{850000}%*%* .+ {333333}%w+_%w+{870000}%[%d+%]: .+ %*%*') or text:find('{460000}%*%* .+ .+{C4C4C4}%[%d+%]: .+ %*%*')) or text:find("%*%* .+ %{......%}.+: ") or text:find('%*%* %{......%}.+№ %d+: {......}.+') or text:find('%*%* %{......%}.+ %{......%}.+%{......}%[%d+%]: .+') or text:find("%*%* .+%[%d+%]: {......}"), -- Чат организации (скрывает рации госок/банд/хитов, /d и /u оставлены)
        ['fam'] = text:find('%[F%] .+ %{......%}.+%[%d+%]: {......}.+'), -- Чат семьи
        ['ads'] = text:find('%* %[.*Реклама%]:{......}.+, {......}Контакт: [^Неизвестный]') or text:find('%* Обработал:{......} .+ %*'), -- Объявления от игроков
        ['invites'] = (color == -86 or color == -858993494) and (text:find("%*%*%p+{") or text:find("%[ {00cc00}Открыт {ffffff}| {00cc00}/invites {ffffff}%]") or text:find("Открыт призыв в NGSA: %[ {333300}Открыт {ffffff}|")), -- Наборы в организации
