local workability_stats_path = script_directory..'/workability_stats.txt'
local function saveWorkabilityStats()
    local file = io.open(workability_stats_path, 'w')
    if not file then return false end
    if type(mainIni.stats) == 'table' then
        for _, line in ipairs(mainIni.stats) do
            if type(line) == 'string' and line ~= '' then file:write(line, '\n') end
        end
    end
    file:close()
    return true
end
local function loadWorkabilityStats()
    local oldStats = type(mainIni.stats) == 'table' and mainIni.stats or {}
    mainIni.stats = {}
    local file = io.open(workability_stats_path, 'r')
    if file then
        for line in file:lines() do
            if line ~= '' then table.insert(mainIni.stats, line) end
        end
        file:close()
    else
        -- Однократный перенос старых записей, если они были в памяти как таблица.
        for _, line in ipairs(oldStats) do
            if type(line) == 'string' then table.insert(mainIni.stats, line) end
        end
        saveWorkabilityStats()
    end
end
loadWorkabilityStats()
