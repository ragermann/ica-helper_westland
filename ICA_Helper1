-- Привязка к серийному номеру тома диска, на котором установлена GTA.
-- Добавляй разрешённые номера сюда: ['30801123'] = true,
-- Команда /ica_update регистрируется отдельно и работает даже до добавления номера.
local ICA_ALLOWED_VOLUME_SERIALS = {
    -- ['1147764179'] = true,
}

local ICA_UPDATE_SCRIPT_URL = 'https://raw.githubusercontent.com/ragermann/ica-helper_westland/refs/heads/main/ICA_Helper1'
local ICA_UPDATE_TEMP_PATH = getWorkingDirectory() .. '/config/ICA Helper/ICA_Helper.lua.update'

local function icaGetGameVolumeSerial()
    local ok, serial = pcall(function()
        local ffi = require 'ffi'
        pcall(ffi.cdef, [[
            int __stdcall GetVolumeInformationA(
                const char* lpRootPathName,
                char* lpVolumeNameBuffer,
                unsigned long nVolumeNameSize,
                unsigned long* lpVolumeSerialNumber,
                unsigned long* lpMaximumComponentLength,
                unsigned long* lpFileSystemFlags,
                char* lpFileSystemNameBuffer,
                unsigned long nFileSystemNameSize
            );
        ]])

        local gamePath = getGameDirectory()
        if type(gamePath) ~= 'string' then return nil end
        local drive = gamePath:match('^%s*([A-Za-z]:)')
        if not drive then return nil end
        local root = drive .. '\\'
        local volumeSerial = ffi.new('unsigned long[1]')
        local volumeName = ffi.new('char[261]')
        local fileSystemName = ffi.new('char[261]')
        local kernel32 = ffi.load('kernel32')
        local success = kernel32.GetVolumeInformationA(
            root, volumeName, 260, volumeSerial, nil, nil, fileSystemName, 260
        )
        if success == 0 then return nil end
        return tostring(tonumber(volumeSerial[0]))
    end)
    if ok then return serial end
    return nil
end

local function icaCopySerialToClipboard(serial)
    if type(serial) ~= 'string' or serial == '' then return false end
    local ok, copied = pcall(function()
        local ffi = require 'ffi'
        pcall(ffi.cdef, 'void* __stdcall GlobalAlloc(unsigned int uFlags, size_t dwBytes);')
        pcall(ffi.cdef, 'void* __stdcall GlobalLock(void* hMem);')
        pcall(ffi.cdef, 'int __stdcall GlobalUnlock(void* hMem);')
        pcall(ffi.cdef, 'void* __stdcall GlobalFree(void* hMem);')
        pcall(ffi.cdef, 'int __stdcall OpenClipboard(void* hWndNewOwner);')
        pcall(ffi.cdef, 'int __stdcall EmptyClipboard(void);')
        pcall(ffi.cdef, 'void* __stdcall SetClipboardData(unsigned int uFormat, void* hMem);')
        pcall(ffi.cdef, 'int __stdcall CloseClipboard(void);')

        local kernel32 = ffi.load('kernel32')
        local user32 = ffi.load('user32')
        local size = #serial + 1
        local memory = kernel32.GlobalAlloc(0x0002, size) -- GMEM_MOVEABLE
        if memory == nil then return false end
        local pointer = kernel32.GlobalLock(memory)
        if pointer == nil then kernel32.GlobalFree(memory); return false end
        ffi.copy(pointer, serial, size)
        kernel32.GlobalUnlock(memory)

        if user32.OpenClipboard(nil) == 0 then
            kernel32.GlobalFree(memory)
            return false
        end
        user32.EmptyClipboard()
        local result = user32.SetClipboardData(1, memory) -- CF_TEXT
        user32.CloseClipboard()
        if result == nil then kernel32.GlobalFree(memory); return false end
        return true
    end)
    return ok and copied == true
end

local function icaIsDriveAuthorized()
    local serial = icaGetGameVolumeSerial()
    return serial ~= nil and ICA_ALLOWED_VOLUME_SERIALS[serial] == true, serial
end

local function icaWaitForDriveAuthorization()
    local allowed, serial = icaIsDriveAuthorized()
    if allowed then
        sampAddChatMessage('{00FF00}[ICA Helper] Серийный номер диска подтверждён.', -1)
        return true
    end

    if serial then
        local copied = icaCopySerialToClipboard(serial)
        sampAddChatMessage('{B22222}[ICA Helper] Этот диск пока не добавлен в список доступа. Серийный номер тома GTA: {FFFFFF}' .. serial, -1)
        if copied then
            sampAddChatMessage('{00FF00}[ICA Helper] Серийный номер автоматически скопирован в буфер обмена. Отправьте его разработчику.', -1)
        else
            sampAddChatMessage('{FFFF00}[ICA Helper] Не удалось скопировать номер автоматически — скопируйте его из сообщения выше.', -1)
        end
    else
        sampAddChatMessage('{B22222}[ICA Helper] Не удалось определить серийный номер тома диска с GTA.', -1)
    end
    sampAddChatMessage('{FFFFFF}Обновление доступно командой {00FF00}/ica_update{FFFFFF}; пока номер не добавлен в список, функции скрипта недоступны.', -1)
    while true do
        wait(1000)
        local nowAllowed = icaIsDriveAuthorized()
        if nowAllowed then
            sampAddChatMessage('{00FF00}[ICA Helper] Серийный номер диска подтверждён.', -1)
            return true
        end
    end
end

local function icaVersionParts(value)
    local parts = {}
    for part in tostring(value):gmatch('%d+') do
        parts[#parts + 1] = tonumber(part) or 0
    end
    return parts
end

local function icaVersionGreater(a, b)
    local pa, pb = icaVersionParts(a), icaVersionParts(b)
    if #pa == 0 then return false end
    local count = math.max(#pa, #pb)
    for i = 1, count do
        local av, bv = pa[i] or 0, pb[i] or 0
        if av > bv then return true end
        if av < bv then return false end
    end
    return false
end

local function icaReadVersionFromScript(source)
    local version = source:match("local%s+text_version%s*=%s*['\"]([^'\"]+)['\"]")
    local number = source:match('local%s+script_version%s*=%s*(%d+)')
    if not version or not number then return nil end
    return version .. ' ' .. number
end

local function icaSerialListSignatureFromSource(source)
    if type(source) ~= 'string' then return nil end
    local block = source:match('local%s+ICA_ALLOWED_VOLUME_SERIALS%s*=%s*{(.-)}')
    if not block then return nil end
    local serials = {}
    for serial in block:gmatch("['\"](%d+)['\"]%s*=%s*true") do
        serials[#serials + 1] = serial
    end
    table.sort(serials)
    return table.concat(serials, ',')
end

local function icaLocalSerialListSignature()
    local serials = {}
    for serial, allowed in pairs(ICA_ALLOWED_VOLUME_SERIALS) do
        if allowed == true then serials[#serials + 1] = tostring(serial) end
    end
    table.sort(serials)
    return table.concat(serials, ',')
end

local function icaRemoteAccessListChanged(source)
    local remoteSignature = icaSerialListSignatureFromSource(source)
    if remoteSignature == nil then return false end
    return remoteSignature ~= icaLocalSerialListSignature()
end

local function icaInstallUpdate()
    lua_thread.create(function()
        sampAddChatMessage('{FFFFFF}[ICA Helper] Скачиваю обновление с GitHub...', -1)

        local updateDir = getWorkingDirectory() .. '/config/ICA Helper'
        if not doesDirectoryExist(updateDir) then createDirectory(updateDir) end

        local tempPath = ICA_UPDATE_TEMP_PATH
        local done, status = false, nil
        local downloadOk, downloadErr = pcall(function()
            downloadUrlToFile(ICA_UPDATE_SCRIPT_URL, tempPath, function(id, s)
                -- downloadUrlToFile вызывает callback несколько раз; завершаем ожидание
                -- только на конечном статусе, а не на первом событии загрузки.
                if s == dlstatus.STATUS_ENDDOWNLOADDATA or s == dlstatus.STATUSEX_ENDDOWNLOAD then
                    -- В разных сборках MoonLoader успешное завершение может приходить
                    -- под одним из этих статусов; проверяем содержимое файла ниже.
                    done, status = true, true
                elseif s == dlstatus.STATUS_ERROR then
                    done, status = true, false
                end
            end)
        end)
        if not downloadOk then
            sampAddChatMessage('{B22222}[ICA Helper] Ошибка запуска загрузки: '..tostring(downloadErr), -1)
            os.remove(tempPath)
            return
        end

        local ticks = 0
        while not done and ticks < 600 do wait(100); ticks = ticks + 1 end
        if not done then
            sampAddChatMessage('{B22222}[ICA Helper] Превышено время ожидания загрузки.', -1)
            os.remove(tempPath)
            return
        end
        if status ~= true then
            sampAddChatMessage('{B22222}[ICA Helper] Не удалось скачать файл с GitHub.', -1)
            os.remove(tempPath)
            return
        end

        local check = io.open(tempPath, 'rb')
        local downloaded = check and (check:read('*a') or '') or ''
        if check then check:close() end
        if downloaded == '' or not downloaded:find('script_version', 1, true) then
            sampAddChatMessage('{B22222}[ICA Helper] GitHub-файл пустой или не содержит версию. Оригинал не изменён.', -1)
            os.remove(tempPath)
            return
        end

        -- Устанавливаем файл, если повысилась версия ИЛИ изменился список серийных номеров.
        -- Поэтому добавление нового пользователя на GitHub само по себе запускает обновление для всех.
        local latestVersion = icaReadVersionFromScript(downloaded)
        local currentVersion = tostring(text_version) .. ' ' .. tostring(script_version)
        local versionChanged = latestVersion and icaVersionGreater(latestVersion, currentVersion)
        local accessListChanged = icaRemoteAccessListChanged(downloaded)
        if not versionChanged and not accessListChanged then
            sampAddChatMessage('{FFFF00}[ICA Helper] Нет новой версии и список доступа не изменился.', -1)
            os.remove(tempPath)
            return
        end

        -- MoonLoader скрипт использует CP1251, а GitHub обычно отдаёт UTF-8.
        -- Пробуем преобразовать скачанный UTF-8 в текущую кодировку скрипта.
        local conversionOk, converted = pcall(function()
            return encoding.UTF8:decode(downloaded)
        end)
        if conversionOk and type(converted) == 'string' and converted ~= '' then
            local out = io.open(tempPath, 'wb')
            if not out then
                sampAddChatMessage('{B22222}[ICA Helper] Не удалось подготовить файл обновления.', -1)
                os.remove(tempPath)
                return
            end
            out:write(converted)
            out:close()
        end

        local compiled, compileErr = loadfile(tempPath)
        if not compiled then
            sampAddChatMessage('{B22222}[ICA Helper] В обновлении ошибка Lua: '..tostring(compileErr), -1)
            os.remove(tempPath)
            return
        end

        local currentPath = thisScript().path
        -- Резервная копия старой версии не создаётся.
        os.remove(currentPath)

        local installed, installErr = os.rename(tempPath, currentPath)
        if not installed then
            sampAddChatMessage('{B22222}[ICA Helper] Не удалось заменить файл: '..tostring(installErr)..'. Резервная копия отключена.', -1)
            os.remove(tempPath)
            return
        end

        sampAddChatMessage('{00FF00}[ICA Helper] Обновление установлено без создания резервной копии.', -1)
        sampAddChatMessage('{FFFFFF}Перезапустите скрипт клавишами {00FF00}CTRL + R ( или перезайдите в игру ){FFFFFF}.', -1)
    end)
end

local function icaCheckForUpdates()
    lua_thread.create(function()
        local checkPath = ICA_UPDATE_TEMP_PATH .. '.check'
        local finished, result = false, nil
        local ok, err = pcall(function()
            downloadUrlToFile(ICA_UPDATE_SCRIPT_URL, checkPath, function(id, status)
                -- Не считаем STATUS_DOWNLOADINGDATA завершением запроса.
                if status == dlstatus.STATUS_ENDDOWNLOADDATA or status == dlstatus.STATUSEX_ENDDOWNLOAD then
                    -- Считаем оба варианта конечного события завершением;
                    -- реальный успех подтверждается чтением и проверкой файла.
                    finished, result = true, true
                elseif status == dlstatus.STATUS_ERROR then
                    finished, result = true, false
                end
            end)
        end)
        if not ok then
            sampAddChatMessage('{B22222}[ICA Helper] Ошибка проверки обновлений: '..tostring(err), -1)
            return
        end

        local waited = 0
        while not finished and waited < 150 do wait(100); waited = waited + 1 end
        if not finished then
            os.remove(checkPath)
            -- Проверка обновлений необязательна: не показываем ложную ошибку при сбое GitHub.
            return
        end
        if result ~= true then
            os.remove(checkPath)
            -- Проверка обновлений необязательна: пропускаем её при ошибке загрузки.
            return
        end

        -- Некоторые версии downloadUrlToFile сообщают о завершении до того,
        -- как файл становится доступен для чтения. Даём записи завершиться и
        -- повторяем чтение несколько раз, прежде чем считать проверку неудачной.
        local source = ''
        for attempt = 1, 5 do
            wait(200)
            local f = io.open(checkPath, 'rb')
            if f then
                source = f:read('*a') or ''
                f:close()
                if #source > 0 then break end
            end
        end
        os.remove(checkPath)
        -- Для проверки обновлений достаточно убедиться, что получен непустой
        -- Lua-исходник с маркером версии. Не проверяем function main: она может
        -- быть оформлена иначе и не означает, что скачивание было пустым.
        if source == '' or not source:find('script_version', 1, true) then
            -- Если фоновая проверка не прочитала файл, просто пропускаем её.
            return
        end

        local latestVersion = icaReadVersionFromScript(source)
        local currentVersion = tostring(text_version) .. ' ' .. tostring(script_version)
        local versionChanged = latestVersion and icaVersionGreater(latestVersion, currentVersion)
        local accessListChanged = icaRemoteAccessListChanged(source)
        if versionChanged or accessListChanged then
            if versionChanged then
                sampAddChatMessage('{00BFFF}[ICA Helper] Доступно обновление версии ('..latestVersion..').', -1)
            else
                sampAddChatMessage('{00BFFF}[ICA Helper] Список доступа обновлён на GitHub.', -1)
            end
            sampAddChatMessage('{FFFFFF}Для установки изменений введите {00FF00}/ica_update{FFFFFF}.', -1)
        end
    end)
end

