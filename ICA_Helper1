                -- Keep the vertical HUD layout identical whether NAMETAG is ON or OFF.
                local checkstream_pos = (cfd ~= nil and mainIni.hud.ypos - 55 or mainIni.hud.ypos - 35)
    
                if mainIni.config.cstream then
                    local now_cstream_hud = os.clock()
                    if now_cstream_hud - last_cstream_hud_refresh >= 0.25 then
                        local refreshed_cache = {}
                        -- Координаты игрока читаем один раз на обновление кэша.
                        local p_xpos, p_ypos, p_zpos = getCharCoordinates(PLAYER_PED)
                        for id, sum in pairs(c_ids) do
                            if sampIsPlayerConnected(id) then
                                local res, handle = sampGetCharHandleBySampPlayerId(id)
                                if res then
                                    local o_xpos, o_ypos, o_zpos = getCharCoordinates(handle)
                                    local result, distance = pcall(getDistanceBetweenCoords3d, p_xpos, p_ypos, p_zpos, o_xpos, o_ypos, o_zpos)
                                    if result then
                                        local nickname = sampGetPlayerNickname(id) or ('ID '..id)
                                        refreshed_cache[#refreshed_cache + 1] = nickname..' [ '..id..' ] ['..sum..'$] | '..select(1, math.modf(distance))..'m'
                                    end
                                end
                            end
                        end
                        cstream_hud_cache = refreshed_cache
                        last_cstream_hud_refresh = now_cstream_hud
                    end
                    for _, contract_text in ipairs(cstream_hud_cache) do
                        checkstream_pos = checkstream_pos - 15
                        renderFontDrawText(font, contract_text, mainIni.hud.xpos - 1, checkstream_pos, 0xAAFFFFFF)
                    end
                    checkstream_pos = checkstream_pos - 15
                    if #cstream_hud_cache > 0 then renderFontDrawText(font, 'CONTRACTS:', mainIni.hud.xpos - 1, checkstream_pos, 0xAAFFFFFF) end
                else
                    cstream_hud_cache = {}
                end
            
                local nametag_text = (nametagEnabled == false or (nametagEnabled == nil and getInvisibility(id))) and 'NAMETAG [OFF]' or 'NAMETAG [ON]'
                local status_text = nametag_text:find('%[OFF%]') and '[OFF]' or '[ON]'
                local status_color = status_text == '[OFF]' and 0xFFFF5555 or 0xFF55FF55
                local nametag_x = mainIni.hud.xpos - 1
                local nametag_y = (cfd ~= nil and mainIni.hud.ypos - 50 or mainIni.hud.ypos - 27)
                renderFontDrawText(font, 'NAMETAG ', nametag_x, nametag_y, 0xAAFFFFFF, 1)
                local status_x = nametag_x + renderGetFontDrawTextLength(font, 'NAMETAG ')
                renderFontDrawText(font, status_text, status_x, nametag_y, status_color, 1)
                if mainIni.temp.fakenick then
                    local fake_x = status_x + renderGetFontDrawTextLength(font, status_text) + 8
                    renderFontDrawText(font, '[FAKE]', fake_x, nametag_y, 0xFFFF5555, 1)
                end
                end -- hud_labels
            end
        end

        if mainIni.config.cstream or mainIni.config.cstream_chat then
            if (os.clock() - time_stream >= 10) and not sampIsDialogActive() and dialog_cooldown <= 0 then
                c_ids = {}
                sampSendChat('/contractas')
                openContractas = true
                time_stream = os.clock()
            end
        end

        -- Синхронизируем уведомления чата с тем же обновляемым списком контрактов,
        -- что использует визуальный чекер. Опрос также ловит игроков, которые уже
        -- были в стриме до обновления списка /contractas.
        if mainIni.config.cstream_chat then
            if os.clock() - last_stream_chat_check >= 0.5 then
                last_stream_chat_check = os.clock()
                for id, price in pairs(c_ids) do
                    local suppressUntil = cstream_completed_suppress[id]
                    if suppressUntil and suppressUntil > os.clock() then
                        cstream_chat_seen[id] = nil
                    else
                        if suppressUntil then cstream_completed_suppress[id] = nil end
                    if sampIsPlayerConnected(id) then
                        local streamed = sampGetCharHandleBySampPlayerId(id)
                        if streamed and not cstream_chat_seen[id] then
                            cstream_chat_seen[id] = price
                            lastct_instream = id
                            local nickname = sampGetPlayerNickname(id) or ('ID '..id)
                            sampAddChatMessage('{FFFBFB}[ {800000}ICA {FFFBFB}]: Контракт {800000}'..nickname:gsub('_', ' ')..' {FFFBFB}[ {800000}'..id..'{FFFBFB} ] в зоне стрима. Стоимость - {800000}'..price..'$.', -1)
                        end
                    end
                    end
                end

                for id, was_streamed in pairs(cstream_chat_seen) do
                    local suppressUntil = cstream_completed_suppress[id]
                    if suppressUntil and suppressUntil > os.clock() then
                        cstream_chat_seen[id] = nil
                    elseif was_streamed then
                        local streamed = sampIsPlayerConnected(id) and sampGetCharHandleBySampPlayerId(id)
                        if not streamed then
                            local nickname = sampGetPlayerNickname(id) or ('ID '..id)
                            sampAddChatMessage('{FFFBFB}[ {800000}ICA {FFFBFB}]: Контракт {800000}'..nickname:gsub('_', ' ')..' {FFFBFB}[ {800000}'..id..'{FFFBFB} ] покинул зону стрима.', -1)
                            cstream_chat_seen[id] = nil
                        end
                    end
                end
            end
        else
            cstream_chat_seen = {}
        end

        if cfd ~= nil then
            if mainIni.config.autofind then
                if (os.clock() - time_find >= 4) and (cfd ~= nil) then
                    if thispp or mainIni.config.search_other_servers then
                        sampSendChat('/find '..cfd)
                    end
                    time_find = os.clock()
                end
            end

            if not sampIsPlayerConnected(cfd) then
                cfd = nil
                --sampAddChatMessage('[ Мысли ]: Преследование прекращено.', 0xCCCCCC)
            end
        end
    end
end

function getAmmoInClip()
	local struct = getCharPointer(PLAYER_PED)
	local prisv = struct + 0x0718
	local prisv = memory.getint8(prisv, false)
	local prisv = prisv * 0x1C
	local prisv2 = struct + 0x5A0
	local prisv2 = prisv2 + prisv
	local prisv2 = prisv2 + 0x8
	local ammo = memory.getint32(prisv2, false)
	return ammo
end

