function setpoint(sum)
	if sum then
		sum = tostring(sum):reverse()
		array = {}
		for i in sum:gmatch(".") do
			table.insert(array, i)
		end
		sum = ""
		for k, _ in pairs(array) do
			if math.fmod(k, 4) == 0 then
				table.insert(array, k, ".")
			end
		end
		for _, v in pairs(array) do
			sum = sum .. v
		end
		return sum:reverse()
	else
		return "Error"
	end
end

